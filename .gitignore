reports/

# Data dirs: the real data lives outside the repo (~/data/strava-export); never inside it
/data/
/strava-export/
/raw/
/cache/

# Raw ride/export data must never be committed (REQ-010). Synthetic fixtures under tests/fixtures/ are allowed.
*.fit
*.fit.gz
*.gpx
*.gpx.gz
*.tcx
*.tcx.gz
*.zip
activities.csv
!tests/fixtures/**/*.fit
!tests/fixtures/**/*.fit.gz
!tests/fixtures/**/*.gpx
!tests/fixtures/**/*.gpx.gz
!tests/fixtures/**/*.tcx
!tests/fixtures/**/*.tcx.gz
!tests/fixtures/**/*.zip
