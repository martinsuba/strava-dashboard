{
  "name": "strava-dashboard-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . ../tests/acceptance/web ../tests/screenshots",
    "format": "prettier --write . ../tests/acceptance/web ../tests/screenshots",
    "format:check": "prettier --check . ../tests/acceptance/web ../tests/screenshots",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures:site-data": "node scripts/copy-site-data.mjs",
    "test:acceptance": "npm run fixtures:site-data && npm run build && playwright test --project=acceptance",
    "screenshots": "npm run fixtures:site-data && npm run build && playwright test --project=screenshots"
  },
  "dependencies": {
    "chart.js": "4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
